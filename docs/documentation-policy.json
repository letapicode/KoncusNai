  "requiredClaims": [
    {
      "id": "reader-window-dimensions",
      "path": "docs/quality/window-shell-manual-evidence.md",
      "pattern": "ReaderWindow.*Width=.?1380.? Height=.?860.? MinWidth=.?1040.? MinHeight=.?700",
      "message": "ReaderWindow evidence must retain the current 1380x860 default and 1040x700 minimum."
    },
    {
      "id": "history-plaintext-boundary",
      "path": "docs/architecture/product-capability-matrix.md",
      "pattern": "always-on local plaintext JSONL",
      "message": "The product capability owner must state the always-on local plaintext JSONL history boundary."
    },
    {
      "id": "explicit-theme-boundary",
      "path": "docs/architecture/product-capability-matrix.md",
      "pattern": "Explicit Dark/Light",
      "message": "The product capability owner must state the explicit Dark/Light theme boundary."
    }
  ],
  "retiredClaims": [
    {
      "id": "optional-history",
      "pattern": "(?i)\\bhistory\\s+is\\s+(?:an?\\s+)?optional\\b",
      "message": "History is always on; describe the local plaintext boundary instead."
    },
    {
      "id": "encrypted-history-promise",
      "pattern": "(?i)\\bhistory\\s+(?:stores?|uses|is)\\s+(?:locally\\s+)?encrypted\\b|\\bhistory stores encrypted text when enabled\\b",
      "message": "History is not application-encrypted or optional."
    },
    {
      "id": "raw-audio-in-history",
      "pattern": "(?i)\\b(?:raw\\s+)?(?:microphone\\s+)?audio\\s+(?:is\\s+)?(?:stored|saved|retained)\\s+in\\s+history\\b",
      "message": "Raw microphone audio is not stored in history."
    },
    {
      "id": "cloud-local-workflow",
      "pattern": "(?i)\\b(?:dictation|local chat)\\s+(?:runs?|is processed|processing occurs)\\s+(?:in|on|through)\\s+(?:the\\s+)?cloud\\b",
      "message": "Dictation and local chat processing remain on-device."
    },
    {
      "id": "system-theme-tracking",
      "pattern": "(?i)\\b(?:supports?|uses?|tracks?|follows?)\\s+(?:the\\s+)?Windows\\s+System[- ]theme\\b",
      "message": "Only explicit Dark/Light selection is supported."
    },
    {
      "id": "mutable-llama-download",
      "pattern": "(?i)\\b(?:download|resolve|fetch)(?:s|ed|ing)?\\b[^\\r\\n]{0,80}\\bllama(?:\\.cpp)?\\b[^\\r\\n]{0,80}\\b(?:latest|main|master)\\b",
      "message": "llama.cpp acquisition must use its immutable recorded release."
    },
    {
      "id": "tag-only-ci-action",
      "pattern": "(?i)\\bactions/(?:checkout|setup-dotnet|upload-artifact)@v\\d+\\b",
      "message": "GitHub Actions must use the immutable commit recorded by supply-chain provenance."
    },
    {
      "id": "retired-tool-source-path",
      "pattern": "(?i)\\bsrc[\\\\/]+DictateAnywhere\\.(?:ModelBenchmark|TtsCli|Spikes)(?:[\\\\/]|\\b)",
      "message": "Retained developer executables live under tools, not src."
    },
    {
      "id": "overlay-manual-exemption",
      "pattern": "(?i)\\b(?:toast|overlay)[^\\r\\n]{0,100}\\bexempt\\s+from\\s+(?:theme|scaling|contrast|legibility)\\b",
      "message": "Non-activating overlays are exempt only from caption/activation cases."
    }
  ]
