<Window x:Class="DictateAnywhere.App.Productivity.RetryFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:DictateAnywhere.App.Presentation"
        presentation:WindowThemeBehavior.IsEnabled="True"
        Title="Retry Last Dictation" Width="400" MinWidth="320"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent" PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnLoaded">
  <Border Margin="8" Padding="20"
          Background="{DynamicResource Brush.Surface.Elevated}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(presentation:WindowThemeBehavior.IsHighContrastActive)}"
                       Value="True">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="0" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
    <StackPanel>
      <TextBlock x:Name="HeadingText" FontSize="{DynamicResource Font.Size.Subheading}"
                 FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
      <TextBlock x:Name="MessageText" Margin="0,10,0,0"
                 FontSize="{DynamicResource Font.Size.Body}"
                 Foreground="{DynamicResource Brush.Text.Secondary}"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="CloseButton" Margin="0,20,0,0" MinWidth="84"
              HorizontalAlignment="Right" Content="OK" IsDefault="True"
              Style="{StaticResource AppPrimaryActionButtonStyle}"
              Click="OnCloseClicked" />
    </StackPanel>
  </Border>
</Window>
