<UserControl x:Class="DictateAnywhere.App.Workbench.WorkbenchComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workbench="clr-namespace:DictateAnywhere.App.Workbench">
  <StackPanel HorizontalAlignment="Stretch"
              MaxWidth="720">
    <workbench:WorkbenchChatProgressView x:Name="ProgressView"
                                          Margin="0,0,0,8"
                                          HorizontalAlignment="Left" />
    <Border x:Name="SpeechPreparationStatus"
            Margin="0,0,0,8"
            Padding="12,8"
            HorizontalAlignment="Left"
            Background="{DynamicResource Brush.Surface.Elevated}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
      <StackPanel Orientation="Horizontal">
        <ProgressBar Width="42"
                     Height="4"
                     Margin="0,0,10,0"
                     VerticalAlignment="Center"
                     IsIndeterminate="True" />
        <TextBlock x:Name="SpeechPreparationText"
                   Style="{DynamicResource SubtleLabelStyle}"
                   VerticalAlignment="Center"
                   Text="Preparing local read-aloud…" />
      </StackPanel>
    </Border>

    <Border x:Name="CompactComposer"
            HorizontalAlignment="Stretch"
            MinHeight="56"
            Padding="10,10"
            Background="{DynamicResource Brush.Surface.Composer}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="1"
            CornerRadius="24"
            SnapsToDevicePixels="True">
      <StackPanel>
        <ItemsControl x:Name="PendingFiles"
                      Margin="4,0,4,6"
                      Visibility="Collapsed">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,6,4"
                      Padding="9,5"
                      Background="{DynamicResource Brush.Surface.Elevated}"
                      BorderBrush="{DynamicResource Brush.Border.Subtle}"
                      BorderThickness="1"
                      CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                  <TextBlock MaxWidth="180"
                             VerticalAlignment="Center"
                             Text="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding SourcePath}" />
                  <Button Margin="7,0,0,0"
                          Padding="2,0"
                          Style="{DynamicResource ComposerIconButtonStyle}"
                          Tag="{Binding Id}"
                          ToolTip="Remove file"
                          AutomationProperties.Name="Remove attached file"
                          Click="OnRemovePendingFileClicked"
                          Content="&#x00D7;" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel Grid.Row="1" Grid.ColumnSpan="6">
          <Button x:Name="NewChatButton"
                  Margin="0,8,8,0"
                  Style="{DynamicResource AppActionButtonStyle}"
                  ToolTip="New chat"
                  ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="New chat"><StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}" Text="&#xE710;" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="New chat" /></StackPanel></Button>

          <Button x:Name="AddFile"
                  Margin="0,8,8,0"
                  Style="{DynamicResource AppActionButtonStyle}"
                  ToolTip="Add file"
                  ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Add file"><StackPanel Orientation="Horizontal">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}" Text="&#xE723;" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Import" /></StackPanel></Button>

          <Button x:Name="ReadDocument"
                  Margin="0,8,8,0"
                  Style="{DynamicResource AppActionButtonStyle}"
                  ToolTip="Open Reading Studio"
                  ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Open Reading Studio"><StackPanel Orientation="Horizontal">
            <Viewbox Width="21" Height="21">
              <Grid Width="24" Height="24">
                <Path Data="M12,19 C9.6,17.4 6.8,16.5 3.4,16.8 L3.4,5.3 C7,4.8 9.8,5.8 12,7.5 Z M12,19 C14.4,17.4 17.2,16.5 20.6,16.8 L20.6,5.3 C17,4.8 14.2,5.8 12,7.5 Z"
                      Fill="#18FFFFFF"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.55"
                      StrokeLineJoin="Round" />
                <Path Data="M12,7.5 L12,19"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.55"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Grid>
            </Viewbox>
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Reading Studio" /></StackPanel></Button>

          <Button x:Name="ExportChatButton"
                  Margin="0,8,8,0"
                  IsEnabled="False"
                  Style="{DynamicResource ComposerIconButtonStyle}"
                  ToolTip="Export this chat"
                  ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Export this chat">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}" Text="&#xE74E;" />
          </Button>

          <Button x:Name="StopSpeaking"
                  Margin="0,8,8,0"
                  Style="{DynamicResource ComposerStopButtonStyle}"
                  ToolTip="Stop reading aloud"
                  AutomationProperties.Name="Stop reading aloud"
                  Content="Stop" />

          </WrapPanel>
          <TextBox x:Name="Prompt"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="8"
                   Margin="2,0,2,0"
                   Style="{DynamicResource ComposerTextBoxStyle}"
                   ToolTip="Ask or dictate into this box."
                   AutomationProperties.Name="Composer prompt" />
          <TextBlock x:Name="PromptPlaceholder"
                     Grid.Row="0"
                     Grid.Column="0"
                     Grid.ColumnSpan="8"
                     Margin="14,0,8,0"
                     VerticalAlignment="Center"
                     FontSize="16"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     IsHitTestVisible="False"
                     Text="Just Ask" />

          <Button x:Name="ExpandPrompt"
                  Grid.Row="1"
                  Grid.Column="5"
                  Margin="0,8,0,0"
                  HorizontalAlignment="Left"
                  Visibility="Collapsed"
                  Style="{DynamicResource ComposerIconButtonStyle}"
                  ToolTip="Expand composer"
                  AutomationProperties.Name="Expand composer">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}" Text="&#xE740;" />
          </Button>

          <Button x:Name="Record"
                  Grid.Row="1"
                  Grid.Column="6"
                  Margin="0,8,8,0"
                  Style="{DynamicResource ComposerSubmitButtonStyle}"
                  ToolTip="Dictate"
                  AutomationProperties.Name="Dictate">
            <TextBlock x:Name="RecordIcon"
                       Style="{DynamicResource AppIconGlyphTextBlockStyle}"
                       FontSize="15"
                       Text="&#xE720;" />
          </Button>

          <Button x:Name="StopDictation"
                  Grid.Row="1"
                  Grid.Column="6"
                  Margin="0,8,8,0"
                  Visibility="Collapsed"
                  Style="{DynamicResource ComposerIconButtonStyle}"
                  ToolTip="Stop dictation"
                  AutomationProperties.Name="Stop dictation">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}" Text="&#xE71A;" />
          </Button>

          <Button x:Name="Send"
                  Grid.Row="1"
                  Grid.Column="7"
                  Margin="0,8,0,0"
                  Style="{DynamicResource ComposerSubmitButtonStyle}"
                  ToolTip="Submit"
                  AutomationProperties.Name="Submit">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}" Text="&#xE74A;" />
          </Button>

          <Button x:Name="StopChat"
                  Grid.Row="1"
                  Grid.Column="7"
                  Margin="0,8,0,0"
                  Visibility="Collapsed"
                  Style="{DynamicResource ComposerSubmitButtonStyle}"
                  ToolTip="Stop response"
                  AutomationProperties.Name="Stop response">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}" Text="&#xE71A;" />
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <Border x:Name="HotkeyStatus"
            Margin="0,10,0,0"
            Style="{DynamicResource AppStatusPillBorderStyle}"
            HorizontalAlignment="Center"
            Visibility="Collapsed">
      <TextBlock x:Name="HotkeyStatusText"
                 Style="{DynamicResource SubtleLabelStyle}"
                 Text="Hotkey: not initialized."
                 AutomationProperties.LiveSetting="Polite" />
    </Border>
  </StackPanel>
</UserControl>
