<UserControl x:Class="DictateAnywhere.App.Workbench.Reading.ReaderTransportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Border x:Name="ReaderFooterSurface" Background="{DynamicResource Brush.Surface.Base}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="30,12,30,14">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="ElapsedTimeTextBlock" MinWidth="44" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.Caption}" Text="0:00" />
        <Slider x:Name="SeekSlider" Grid.Column="1" Margin="10,0" Style="{DynamicResource ReaderSlider}" Minimum="0" Maximum="1"
                AutomationProperties.Name="Reading position" />
        <TextBlock x:Name="DurationTextBlock" Grid.Column="2" MinWidth="44" TextAlignment="Right" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.Caption}" Text="0:00" />
      </Grid>
      <Grid Grid.Row="1" Margin="0,9,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="PlaybackStatusTextBlock" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}"
                   FontSize="{DynamicResource Font.Size.Body}" AutomationProperties.LiveSetting="Polite" />
        <StackPanel x:Name="ReadingTransportPanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
          <StackPanel x:Name="DocumentIdentityPanel" MaxWidth="330" Margin="0,0,16,0" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock x:Name="DocumentTitleTextBlock" Visibility="Collapsed" />
            <TextBlock x:Name="DocumentMetaTextBlock" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="{DynamicResource Font.Size.Caption}" />
            <TextBlock x:Name="SectionStatusTextBlock" Visibility="Collapsed" />
            <TextBlock x:Name="DocumentProgressTextBlock" Visibility="Collapsed" />
            <ProgressBar x:Name="DocumentProgressBar" Visibility="Collapsed" Minimum="0" Maximum="1" AutomationProperties.Name="Document progress" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="PreviousButton" Style="{DynamicResource ReaderSecondaryButton}" Margin="0,0,9,0" Content="Previous" AutomationProperties.Name="Previous section" />
            <Button x:Name="PlayPauseButton" Style="{DynamicResource ReaderPrimaryButton}" Margin="0,0,9,0" Content="Play" AutomationProperties.Name="Play" />
            <Button x:Name="NextButton" Style="{DynamicResource ReaderSecondaryButton}" Margin="0,0,9,0" Content="Next" AutomationProperties.Name="Next section" />
            <Button x:Name="EditDocumentButton" Style="{DynamicResource ReaderIconButton}" Margin="0,0,9,0"
                    ToolTip="Edit text" AutomationProperties.Name="Edit text">
              <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M4,18 L5.2,13.5 L15.8,2.9 C16.6,2.1 17.8,2.1 18.6,2.9 L19.1,3.4 C19.9,4.2 19.9,5.4 19.1,6.2 L8.5,16.8 Z M12.8,5.9 L16.1,9.2" />
            </Button>
            <Button x:Name="DistractionFreeButton" Style="{DynamicResource ReaderIconButton}"
                    ToolTip="Fullscreen reading mode" AutomationProperties.Name="Fullscreen reading mode">
              <Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Data="M7,2 H2 V7 M2,2 L8,8 M17,2 H22 V7 M22,2 L16,8 M7,22 H2 V17 M2,22 L8,16 M17,22 H22 V17 M22,22 L16,16" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
