<Window x:Class="DictateAnywhere.App.Workbench.Reading.ReaderCompletionToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="118" MinHeight="118" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        BorderThickness="0"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Opacity="0"
        Loaded="OnLoaded">
  <Border x:Name="ToastCard" Margin="8" Padding="18,18,18,13" Background="#F5172236" BorderBrush="#52627E" BorderThickness="1" CornerRadius="16"
          RenderTransformOrigin="1,1">
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="ToastScaleTransform" ScaleX="1" ScaleY="1" />
        <TranslateTransform x:Name="ToastSlideTransform" X="72" Y="0" />
      </TransformGroup>
    </Border.RenderTransform>
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.42" Color="#02050A" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#D9B45F" CornerRadius="18">
          <Path Width="16" Height="12" Stretch="Fill" Stroke="#111A2C" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Data="M1,6 L6,11 L15,1" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="TitleTextBlock" Foreground="#FFF8EC" FontFamily="Georgia" FontSize="{DynamicResource Font.Size.Section}" FontWeight="SemiBold" Text="Your audiobook is ready" TextWrapping="Wrap" />
          <TextBlock x:Name="DetailTextBlock" Margin="0,6,0,0" Foreground="#B7C2D7" FontSize="{DynamicResource Font.Size.FieldLabel}" LineHeight="{DynamicResource Line.Height.Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="46,8,0,0" Background="#3C4B66" CornerRadius="2">
        <Border x:Name="ToastRevealBar" HorizontalAlignment="Stretch" Background="#D9B45F" CornerRadius="2" RenderTransformOrigin="0,0.5">
          <Border.RenderTransform><ScaleTransform x:Name="ToastRevealTransform" ScaleX="0" /></Border.RenderTransform>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
