<UserControl x:Class="DictateAnywhere.App.Workbench.Reading.ReaderDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reading="clr-namespace:DictateAnywhere.App.Workbench.Reading"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="ReaderDocumentScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="34">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ReaderThumbChrome" Width="4" HorizontalAlignment="Center"
                              Background="{DynamicResource Brush.Scrollbar.Thumb}" CornerRadius="2" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ReaderThumbChrome" Property="Background" Value="{DynamicResource Brush.Scrollbar.ThumbHover}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid x:Name="ReaderPageHost" Margin="26,8,26,20">
    <Border x:Name="ReaderPageFrame" MinHeight="520" MinWidth="560" MaxWidth="1180"
            Padding="2" Background="#1B2840" CornerRadius="18" UseLayoutRounding="False">
      <Border x:Name="ReaderPageSurface" Background="#F9F2E8" CornerRadius="16" Padding="45,40,45,42">
        <Grid>
          <ScrollViewer x:Name="ReaderScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ReaderDocumentScrollBar}" /></ScrollViewer.Resources>
            <reading:ReaderHighlightTextBlock x:Name="ReaderTextBlock" Margin="21,12,21,16"
                       FontFamily="Georgia" FontSize="23" LineHeight="37"
                       LineStackingStrategy="MaxHeight" TextWrapping="Wrap" Foreground="#182237" />
          </ScrollViewer>
          <TextBox x:Name="DraftTextBox" Style="{DynamicResource ReaderDraftInput}" Visibility="Collapsed"
                    PreviewKeyDown="OnDraftPreviewKeyDown"
                    AutomationProperties.Name="Reading draft"
                    AutomationProperties.HelpText="Edit narration text">
            <TextBox.ToolTip>
              <ToolTip x:Name="DraftToolTip" MaxWidth="380"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center">
                <TextBlock x:Name="DraftToolTipTextBlock"
                           Text="Edit narration text"
                           FontFamily="Segoe UI"
                           FontSize="{DynamicResource Font.Size.Body}"
                           LineHeight="{DynamicResource Line.Height.Caption}"
                           LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" />
              </ToolTip>
            </TextBox.ToolTip>
          </TextBox>
          <TextBlock x:Name="DraftInvitation" Margin="24,20,24,0" VerticalAlignment="Top" IsHitTestVisible="False"
                     FontFamily="Segoe UI" FontSize="{DynamicResource Font.Size.Lead}" TextWrapping="Wrap"
                     Foreground="{Binding Foreground, ElementName=DraftTextBox}"
                     Text="Start writing, paste text, or import a document.">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Text, ElementName=DraftTextBox}" Value="" />
                      <Condition Binding="{Binding Visibility, ElementName=DraftTextBox}" Value="Visible" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Grid x:Name="FocusedReadingSurface" Margin="38" Visibility="Collapsed">
            <ScrollViewer x:Name="FocusedScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
            <Border x:Name="FocusedSentenceHighlightSurface" MaxWidth="980" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24,16" Background="Transparent" CornerRadius="16">
              <reading:ReaderHighlightTextBlock x:Name="FocusedReadingTextBlock" MaxWidth="900" HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontFamily="Georgia" FontSize="46" LineHeight="70" LineStackingStrategy="MaxHeight"
                         TextAlignment="Center" TextWrapping="Wrap" Foreground="#182237" />
            </Border>
            </ScrollViewer>
          </Grid>
          <Border x:Name="PreparationOverlay" Background="#FAF6EE" CornerRadius="10" Visibility="Collapsed"
                  AutomationProperties.Name="Reading operation progress">
            <StackPanel Width="390" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="PreparationMessageTextBlock" Foreground="#182237" FontFamily="Georgia" FontSize="{DynamicResource Font.Size.Subheading}"
                         FontWeight="SemiBold" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
              <Grid Margin="54,22,54,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="PreparationElapsedTextBlock" Foreground="#667188" Opacity="0.7" FontSize="{DynamicResource Font.Size.Lead}" FontWeight="SemiBold" Text="Elapsed 0:00" />
                <TextBlock x:Name="PreparationProgressTextBlock" Grid.Column="1" Foreground="#354158" Opacity="0.82" FontSize="{DynamicResource Font.Size.BodyComfortable}" FontWeight="SemiBold" Text="0%" AutomationProperties.LiveSetting="Polite" />
              </Grid>
              <ProgressBar x:Name="PreparationProgressBar" Margin="54,0,54,0" Height="6" Minimum="0" Maximum="1"
                           Foreground="#C99D54" Background="#E8DCCB" AutomationProperties.Name="Preparation progress" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Border>
    <Border x:Name="DraftFocusBoundary"
            Panel.ZIndex="1"
            Width="{Binding ActualWidth, ElementName=ReaderPageFrame}"
            Height="{Binding ActualHeight, ElementName=ReaderPageFrame}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="{Binding CornerRadius, ElementName=ReaderPageFrame}"
            Focusable="False"
            IsHitTestVisible="False"
            UseLayoutRounding="False" />
  </Grid>
</UserControl>
