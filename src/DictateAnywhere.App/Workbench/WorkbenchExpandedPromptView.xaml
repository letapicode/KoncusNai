<UserControl x:Class="DictateAnywhere.App.Workbench.WorkbenchExpandedPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:DictateAnywhere.App.Presentation"
             Visibility="Collapsed">
  <Border x:Name="Surface"
          Background="{DynamicResource Brush.Surface.Composer}"
          BorderBrush="{DynamicResource Brush.Border.Subtle}"
          BorderThickness="1"
          CornerRadius="18">
    <Grid>
      <presentation:PaperTexture x:Name="PaperGrain" CornerRadius="17" Visibility="Collapsed" />
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="Prompt"
                 Grid.Row="0"
                 MinHeight="260"
                 Padding="12"
                 FontSize="16"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Expanded prompt" />

        <StackPanel Grid.Row="1"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <Button x:Name="Collapse"
                  Style="{DynamicResource ComposerIconButtonStyle}"
                  ToolTip="Collapse composer"
                  AutomationProperties.Name="Collapse composer">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}"
                       Text="&#xE73F;" />
          </Button>
          <Button x:Name="Submit"
                  Margin="8,0,0,0"
                  Style="{DynamicResource ComposerSubmitButtonStyle}"
                  ToolTip="Submit"
                  AutomationProperties.Name="Submit">
            <TextBlock Style="{DynamicResource AppIconGlyphTextBlockStyle}"
                       Text="&#xE74A;" />
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
