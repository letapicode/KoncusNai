<UserControl x:Class="DictateAnywhere.App.Hotkeys.HotkeyCaptureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown">
  <StackPanel>
    <DockPanel>
      <Button x:Name="CaptureButton"
              DockPanel.Dock="Right"
              Margin="8,0,0,0"
              Padding="14,6"
              Click="OnCaptureClicked"
              Content="Change"
              AutomationProperties.Name="Change hotkey" />
      <TextBox x:Name="HotkeyTextBox"
               IsReadOnly="True"
               VerticalContentAlignment="Center"
               AutomationProperties.Name="Assigned hotkey" />
    </DockPanel>
    <TextBlock x:Name="StatusTextBlock"
               Margin="0,7,0,0"
               Visibility="Collapsed"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Status.Warning}"
               AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
