<Window x:Class="DictateAnywhere.App.Hotkeys.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DictateAnywhere.App.Hotkeys"
        xmlns:presentation="clr-namespace:DictateAnywhere.App.Presentation"
        presentation:WindowThemeBehavior.IsEnabled="True"
        Title="Koncus Nai Hotkeys"
        Width="700"
        Height="360"
        MinWidth="500"
        MinHeight="300"
        Loaded="OnLoaded">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               TextWrapping="Wrap"
               Text="Choose your dictation hotkey. Validation is done against Windows global hotkey registration, so conflicts are rejected immediately." />

    <local:HotkeyCaptureControl x:Name="HotkeyCaptureControl"
                                Grid.Row="1"
                                Margin="0,12,0,0" />

    <TextBlock x:Name="PersistStatusTextBlock"
               Grid.Row="2"
               Margin="0,8,0,0"
               Foreground="{DynamicResource Brush.Status.Success}"
               AutomationProperties.LiveSetting="Polite" />

    <TextBlock Grid.Row="3"
               Margin="0,12,0,0"
               TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Text.Secondary}"
               Text="Use 'Hotkey Test' to confirm what Windows receives on your hardware. Fn keys are device-dependent and may not be available." />

    <StackPanel Grid.Row="4"
                Margin="0,12,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Margin="0,0,8,0"
              Padding="10,4"
              Click="OnHotkeyTestClicked"
              Content="Hotkey Test" />
      <Button Padding="10,4"
              Click="OnCloseClicked"
              Content="Close" />
    </StackPanel>
  </Grid>
</Window>
