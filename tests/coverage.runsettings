<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[DictateAnywhere.*]*</Include>
          <Exclude>[*.Tests]*</Exclude>
          <ExcludeByFile>**/*.g.cs,**/*.g.i.cs,**/*.designer.cs,**/*.AssemblyInfo.cs,**/*.AssemblyAttributes.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
